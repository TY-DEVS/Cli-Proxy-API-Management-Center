# Coolify environment for two separate repositories:
# - UI repo: https://github.com/TY-DEVS/Cli-Proxy-API-Management-Center
# - Backend repo: https://github.com/TY-DEVS/CLIProxyAPI-main
# Use with docker-compose.coolify-private.yml.

# If the backend repo is public, this URL is enough.
# If it is private, replace it in Coolify with an authenticated Git URL.
CLI_PROXY_BUILD_CONTEXT=https://github.com/TY-DEVS/CLIProxyAPI-main.git#main

CLI_PROXY_LOCAL_IMAGE=cli-proxy-api:production
CLI_PROXY_VERSION=main
CLI_PROXY_COMMIT=main
CLI_PROXY_BUILD_DATE=2026-04-20
CLI_PROXY_PORT=8317
CLI_PROXY_CONFIG_PATH=./docker/backend/config.yaml
CLI_PROXY_AUTH_DIR=./docker/backend/auth

APP_PORT=80
# Preferred: let Coolify generate SERVICE_URL_CLI_PROXY_API from the backend service domain.
# Fallback: set APP_DEFAULT_API_BASE manually to your public backend URL if needed.
# APP_DEFAULT_API_BASE=https://your-backend-domain.example.com
