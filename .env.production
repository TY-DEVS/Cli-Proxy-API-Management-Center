CLI_PROXY_BUILD_CONTEXT=https://github.com/Aminetwiti/CLIProxyAPI-main.git#main
CLI_PROXY_LOCAL_IMAGE=cli-proxy-api:production
CLI_PROXY_VERSION=main
CLI_PROXY_COMMIT=main
CLI_PROXY_BUILD_DATE=2026-04-20
CLI_PROXY_HOST_PORT=8317
CLI_PROXY_PORT=8317
CLI_PROXY_CONFIG_PATH=./docker/backend/config.yaml
CLI_PROXY_AUTH_DIR=./docker/backend/auth

APP_HOST_PORT=8080
APP_PORT=80
APP_DEFAULT_API_BASE=http://localhost:8317
# If the UI is accessed through a public domain or reverse proxy, replace with that public backend URL.
# Example: APP_DEFAULT_API_BASE=https://api.example.com
# If your GitHub default branch is not main, replace #main in CLI_PROXY_BUILD_CONTEXT with the correct ref.
# Example: CLI_PROXY_BUILD_CONTEXT=https://github.com/Aminetwiti/CLIProxyAPI-main.git#master
