CLI_PROXY_IMAGE=ghcr.io/router-for-me/cliproxyapi:latest
CLI_PROXY_HOST_PORT=8317
CLI_PROXY_PORT=8317
CLI_PROXY_CONFIG_PATH=./docker/backend/config.yaml
CLI_PROXY_AUTH_DIR=./docker/backend/auth

APP_HOST_PORT=8080
APP_PORT=80
APP_DEFAULT_API_BASE=http://localhost:8317
# If the UI is accessed through a public domain or reverse proxy, replace with that public backend URL.
# Example: APP_DEFAULT_API_BASE=https://api.example.com
# If you want to build the backend from your fork instead of using a published image,
# use docker-compose.production.yml and set CLI_PROXY_BUILD_CONTEXT, CLI_PROXY_LOCAL_IMAGE,
# CLI_PROXY_VERSION, CLI_PROXY_COMMIT, and CLI_PROXY_BUILD_DATE.
